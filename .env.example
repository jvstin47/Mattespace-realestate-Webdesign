# Mattespace Residences — Environment Configuration Template
# Copy this file to .env or .env.local to customize local settings.

# Application Identity
VITE_APP_NAME="Mattespace"
VITE_APP_TAGLINE="Architecture Designed Around Light"

# Contact & Inquiries
VITE_WHATSAPP_PHONE="1234567890"
VITE_WHATSAPP_DEFAULT_MESSAGE="Hello, I am interested in Mattespace Residences."
VITE_CONTACT_EMAIL="concierge@mattespace.com"

# API Configuration
VITE_API_BASE_URL="/api/v1"
VITE_API_TIMEOUT_MS=10000
VITE_ENABLE_MOCK_API=true

# Hero Playback Engine Tuning
VITE_HERO_HOLD_DURATION_MS=450
VITE_HERO_MIN_PLAYBACK_MS=400
